#!/bin/sh
# Bootstrap a fresh machine with required packages.
# chezmoi runs this exactly once per machine (run_once_ semantics).
set -e

{{ if eq .chezmoi.os "darwin" -}}
# ── macOS ─────────────────────────────────────────────────────────────────────

if ! command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  else
    echo "Homebrew installation completed, but brew was not found on a supported path." >&2
    exit 1
  fi
fi

brew install \
  bat \
  eza \
  fzf \
  gh \
  lazydocker \
  mise \
  powerlevel10k \
  ripgrep \
  zsh-autosuggestions \
  zsh-completions \
  zsh-history-substring-search \
  zsh-syntax-highlighting

{{ if .is_work -}}
brew install \
  helm \
  yq
{{ end -}}

brew install herdr

brew install --cask ghostty

{{ else if or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "omarchy") -}}
# ── Arch Linux (Omarchy) ──────────────────────────────────────────────────────

# Omarchy already installs bat, eza, fzf, lazydocker, mise, and ripgrep.
# Install Ghostty, the remote-access services, and GitHub CLI managed here.
# Omarchy's Bash and Starship configuration remain the shell defaults.
sudo pacman -S --needed --noconfirm ghostty github-cli openssh tailscale
omarchy default terminal ghostty
sudo systemctl enable sshd.service

# Use Omarchy's installer to install 1Password and its CLI.
omarchy-install-service-1password

# Amp installs to ~/.amp/bin and links its executable into ~/.local/bin.
curl -fsSL https://ampcode.com/install.sh | env PATH="$HOME/.local/bin:$PATH" bash

omarchy pkg add herdr

{{ if .is_work -}}
omarchy pkg add cursor-bin cursor-agent helm yq
{{ end -}}

# Enable Tailscale SSH when this Omarchy machine is already connected to the tailnet.
if command -v tailscale >/dev/null 2>&1 && tailscale status >/dev/null 2>&1; then
  tailscale set --ssh
else
  echo "WARNING: Tailscale is unavailable or not connected; skipping Tailscale SSH." >&2
fi

{{ else -}}
echo "Unsupported operating system. This bootstrap supports macOS and Omarchy (Arch Linux) only." >&2
exit 1

{{ end -}}

echo "Bootstrap complete. Open a new shell or run: chezmoi apply"
